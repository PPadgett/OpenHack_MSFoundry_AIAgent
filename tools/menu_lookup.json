{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Menu Lookup Tool",
  "description": "Retrieve menu items by size, crust, or topping category. Idempotent GET operation.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "menu_lookup"
    },
    "description": {
      "type": "string",
      "const": "Get menu items and options"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "object" },
        "properties": {
          "type": "object",
          "properties": {
            "size": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "const": "string" },
                "enum": {
                  "type": "array",
                  "items": { "type": "string" },
                  "const": ["small", "medium", "large", "xlarge"]
                },
                "description": { "type": "string" }
              }
            },
            "crust": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "const": "string" },
                "enum": {
                  "type": "array",
                  "items": { "type": "string" },
                  "const": ["thin", "hand-tossed", "stuffed-crust", "pan"]
                },
                "description": { "type": "string" }
              }
            },
            "topping_category": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "const": "string" },
                "enum": {
                  "type": "array",
                  "items": { "type": "string" },
                  "const": ["meats", "veggies", "sauces", "cheeses", "all"]
                },
                "description": { "type": "string" }
              }
            }
          }
        },
        "required": {
          "type": "array",
          "const": []
        }
      }
    }
  },
  "required": ["name", "description", "parameters"],
  "properties_comment": {
    "idempotence": "GET operation; safe to call multiple times; same input → same output",
    "usage_rule": "Call when customer asks about menu items, sizes, crusts, or available toppings",
    "error_handling": "If tool fails, retry once; if still fails, offer human_handoff"
  }
}
