{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pizza Quantity Estimate Tool",
  "description": "Estimate pizza quantity for a group using diner count and appetite. Deterministic and idempotent.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "pizza_quantity_estimate"
    },
    "description": {
      "type": "string",
      "const": "Estimate pizzas needed for a group"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "properties": {
          "type": "object",
          "properties": {
            "number_of_people": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "integer"
                },
                "minimum": {
                  "type": "integer",
                  "const": 1
                },
                "description": {
                  "type": "string",
                  "const": "How many diners are eating"
                }
              }
            },
            "appetite_level": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "string"
                },
                "enum": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "const": ["light", "average", "hungry"]
                },
                "description": {
                  "type": "string",
                  "const": "Expected appetite level for the group"
                }
              }
            },
            "slices_per_pizza": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "integer"
                },
                "minimum": {
                  "type": "integer",
                  "const": 4
                },
                "description": {
                  "type": "string",
                  "const": "Slices per pizza (default 8)"
                }
              }
            }
          }
        },
        "required": {
          "type": "array",
          "const": ["number_of_people", "appetite_level"]
        }
      }
    }
  },
  "required": ["name", "description", "parameters"],
  "properties_comment": {
    "idempotence": "Deterministic computation; same inputs produce same recommendation",
    "usage_rule": "Ask number_of_people and appetite_level before calling this tool",
    "response_includes": "recommended_pizzas, estimated_slices, slices_per_person, suggestion_notes"
  }
}
