# Local mock profile for offline lab replay
# Copy values into .env when running without cloud resources.

# Mock base endpoints
PIZZA_API_URL=http://localhost:7071/
REGISTRATION_API_URL=http://localhost:7072/
PIZZA_WEBAPP_URL=http://localhost:4173/
REGISTRATION_WEBAPP_URL=http://localhost:4174/
PIZZA_MCP_URL=http://localhost:8081/sse

# Mock API routes
MENU_LOOKUP_ENDPOINT=/api/menu
ALLERGEN_LOOKUP_ENDPOINT=/api/allergens
PRICE_CALC_ENDPOINT=/api/price
ORDER_SUBMIT_ENDPOINT=/api/orders
ORDER_STATUS_ENDPOINT=/api/orders/{order_id}
HUMAN_HANDOFF_ENDPOINT=/api/escalations

# Mock health routes
HEALTH_ENDPOINT=/health
API_HEALTH_PROBE_ENDPOINT=/api/menu

# API behavior tuning
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3
API_RETRY_BACKOFF_SECONDS=2

# Local environment metadata
AZURE_REGION=westus
AZURE_RESOURCE_GROUP=LabVM-RG

# Foundry/mock parity variables
FOUNDRY_AGENT_NAME=crust
FOUNDRY_LOCATION=westus
FOUNDRY_ACCOUNT_NAME=my-ai-service-2364654
FOUNDRY_MODEL_DEPLOYMENT=gpt-5.4
FOUNDRY_ENDPOINT=https://my-ai-service-2364654.services.ai.azure.com
PROJECT_CONNECTION_STRING=https://my-ai-service-2364654.services.ai.azure.com/api/projects/proj-2364654
FOUNDRY_API_KEY=
AZURE_OPENAI_API_KEY=
